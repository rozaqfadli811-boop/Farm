local function IsEscaped()
    local char = LocalPlayer.Character
    if not char then return false end

    if LocalPlayer:GetAttribute("Escaped") == true then return true end
    if LocalPlayer:GetAttribute("HasEscaped") == true then return true end
    if char:GetAttribute("Escaped") == true then return true end
    if CollectionService:HasTag(LocalPlayer, "Escaped") then return true end
    if CollectionService:HasTag(char, "Escaped") then return true end

    if StableZone == "Lobby" then return true end

    local myPos = GetCharPos()
    if myPos then
        local spawnPart = workspace:FindFirstChild("SpawnLocation")
        if spawnPart and spawnPart:IsA("BasePart") then
            if (myPos - spawnPart.Position).Magnitude < 100 then return true end
        end
        local lobbyFolder = workspace:FindFirstChild("Lobby")
        if lobbyFolder then
            local center = GetFolderCenter(lobbyFolder)
            if center and (myPos - center).Magnitude < 100 then return true end
        end
    end

    if EscBeganAt then
        local elapsed = os.clock() - EscBeganAt
        if elapsed > 3 then
            if not HasTimer() then return true end
            if CountKillers() == 0 then return true end
        end
    end

    return false
end

