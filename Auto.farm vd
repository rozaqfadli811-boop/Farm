local function GetStats()
    local stats = {
        Username = LocalPlayer.Name,
        DisplayName = LocalPlayer.DisplayName,
        UserId = LocalPlayer.UserId,
        Level = "?",
        EXP = "?",
        Gears = "?",
        Screws = "?",
        Timestamp = os.date("%Y-%m-%d %H:%M:%S"),
        JobId = tostring(game.JobId):sub(1, 8),
        PlayerCount = #Players:GetPlayers(),
        Trigger = "auto",
    }

    local lvlTxt = getText("Spectator.Info.Your.Border.Level")
    if lvlTxt and lvlTxt ~= "" then stats.Level = cleanNumber(lvlTxt) end

    local grsTxt = getText("Spectator.Info.Your.Gears")
    if grsTxt and grsTxt ~= "" then stats.Gears = cleanNumber(grsTxt) end

    local scrTxt = getText("Spectator.Info.Your.Screws")
    if scrTxt and scrTxt ~= "" then stats.Screws = cleanNumber(scrTxt) end

    if stats.Level == "?" then
        local found = FindTextByKeywords({"level", "lvl", "tingkat"})
        if found then stats.Level = cleanNumber(found) end
    end
    if stats.Gears == "?" then
        local found = FindTextByKeywords({"gear", "peralatan"})
        if found then stats.Gears = cleanNumber(found) end
    end
    if stats.Screws == "?" then
        local found = FindTextByKeywords({"screw", "sekrup", "baut"})
        if found then stats.Screws = cleanNumber(found) end
    end

    local xp = GetSurvivorXP()
    if xp then stats.EXP = cleanNumber(tostring(xp)) end

    return stats
end

