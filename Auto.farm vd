local function GetServers()
    local url = string.format(
        "https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=%d",
        Config.PlaceId, Config.MaxServersToScan)
    local ok, data = pcall(function()
        return HttpService:JSONDecode(game:HttpGet(url))
    end)
    if ok and data and data.data then return data.data end
    return {}
end

local function PickServer(servers, excludeIds)
    excludeIds = excludeIds or {}
    if not servers or #servers == 0 then
        return nil, "no servers", 0
    end

    local candidates = {}
    for _, s in ipairs(servers) do
        if s.id ~= game.JobId
           and not excludeIds[s.id]
           and s.playing < s.maxPlayers
        then
            table.insert(candidates, s)
        end
    end

    if #candidates == 0 then
        return nil, "semua udah dicoba", 0
    end

    table.sort(candidates, function(a, b)
        if a.playing ~= b.playing then
            return a.playing < b.playing
        end
        return (a.maxPlayers - a.playing) > (b.maxPlayers - b.playing)
    end)

    local pick = candidates[1]
    local mode
    if pick.playing == 0 then mode = "KOSONG (0p)"
    else mode = "sepi (" .. pick.playing .. "p)" end

    return pick, mode, #candidates
end

local HopToServer, ScheduleHopRetry

ScheduleHopRetry = function(reason)
    if not HopInProgress then return end
    HopInProgress = false
    Hopping = false

    if HopRetryCount >= Config.HopRetryMax then
        HopRetryCount = 0
        TriedServers = {}
        task.delay(3, function() HopToServer(reason, true) end)
        return
    end

    HopRetryCount = HopRetryCount + 1
    notify("VD AUTO HOP", "⚠️ Server penuh, retry #" .. HopRetryCount, 2)

    task.delay(Config.HopRetryDelay, function()
        HopToServer(reason, true)
    end)
end

HopToServer = function(reason, isRetry)
    if Hopping then return end
    if not Config.AutoHop then return end

    if not isRetry then
        HopRetryCount = 0
        TriedServers = {}
    end

    Hopping = true
    HopInProgress = true
    HopReason = reason or "cari server sepi"

    UI.status.Text = "Status: Hoping..." .. (isRetry and (" [R" .. HopRetryCount .. "]") or "")
    UI.status.TextColor3 = Color3.fromRGB(255, 200, 80)

    notify("VD AUTO HOP", "🚀 Hop → " .. HopReason
        .. (isRetry and (" [R" .. HopRetryCount .. "]") or ""), 2)

    StopNoclip()

    local servers = GetServers()
    local target, mode, count = PickServer(servers, TriedServers)

    if not target then
        TriedServers = {}
        task.wait(2)
        local retryTarget, retryMode = PickServer(servers, TriedServers)
        if retryTarget then target = retryTarget; mode = retryMode end
    end

    LastHop = os.clock()
    LastAutoHopAt = os.clock()
    CountdownNotified = false
    ResetEsc()
    MapStableStart = 0; MapConfirmedAt = nil
    StableZone = nil; LastZoneCheck = nil; ZoneStableStart = 0
    LastRawZone = nil
    WasInMap = false
    JustEscaped = false
    LobbyArrivedAt = nil

    if target then
        TriedServers[target.id] = true

        UI.info3.Text = "Hop: " .. target.playing .. "/" .. target.maxPlayers
        Hopping = false

        local ok = pcall(function()
            TeleportService:TeleportToPlaceInstance(Config.PlaceId, target.id, LocalPlayer)
        end)

        if not ok then
            task.spawn(function() ScheduleHopRetry(HopReason) end)
            return
        end

        task.delay(Config.HopTimeoutCheck, function()
            if HopInProgress then ScheduleHopRetry(HopReason) end
        end)
    else
        Hopping = false
        HopInProgress = false
        task.delay(5, function() HopToServer(reason, true) end)
    end
end

