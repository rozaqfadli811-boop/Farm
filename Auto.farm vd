        else escInfo = "OFF" end
        UI.info3.Text = "Escape: " .. escInfo .. " | Hop: " .. (Hopping and ("R" .. HopRetryCount) or "idle")

        local s = GetStats()
        UI.info5.Text = string.format("📊 Lv%s | EXP %s | G%s | S%s",
            s.Level, s.EXP, s.Gears, s.Screws)

        if JustEscaped and Config.AutoHop and not Hopping then
            if not LobbyArrivedAt then
                LobbyArrivedAt = now
            end
            local sisa = Config.PostWinDelay - (now - LobbyArrivedAt)
            UI.status.Text = string.format("Status: ESCAPED — hop %.1fs", math.max(0, sisa))
            UI.status.TextColor3 = Color3.fromRGB(120, 255, 180)
            if sisa <= 0 then
                LobbyArrivedAt = nil
                LastHop = 0
                HopToServer("Setelah escape")
                continue
            end
            continue
        else
            LobbyArrivedAt = nil
        end

        if not Config.AutoHop then
            UI.status.Text = "Status: Hop OFF"
            UI.status.TextColor3 = WIND.muted
            continue
        end

        if Hopping then
            UI.status.Text = "Status: Hoping..." .. (HopRetryCount > 0 and (" R" .. HopRetryCount) or "")
            UI.status.TextColor3 = Color3.fromRGB(255, 200, 80)
            continue
        end

        if not spawned then
            ResetEsc()
            KillerNotified = false
            UI.status.Text = "Status: BELUM SPAWN"
            UI.status.TextColor3 = Color3.fromRGB(255, 220, 100)
            continue
        end

        if IsCountdownActive() then
            LastAutoHopAt = now
            UI.info3.Text = "Escape: " .. escInfo .. " | COUNTDOWN AKTIF"
            if not CountdownNotified then
                CountdownNotified = true
                notify("VD AUTO HOP", "⏸️ Countdown terdeteksi — hop di-tunda", 3)
            end
        elseif (now - LastAutoHopAt) >= Config.AutoHopInterval then
            UI.status.Text = "Status: AUTO HOP (2 menit)"
            UI.status.TextColor3 = Color3.fromRGB(255, 150, 80)
            LastAutoHopAt = now
            CountdownNotified = false
            HopToServer("Auto hop 2 menit")
            continue
        else
            CountdownNotified = false
        end

        if IsPlayerKiller() then
            if not KillerNotified then
                KillerNotified = true
                notify("VD AUTO HOP", "🔪 KILLER MODE → hop", 4)
            end
            UI.status.Text = "Status: KILLER → HOP"
            UI.status.TextColor3 = Color3.fromRGB(255, 100, 100)
            HopToServer("Jadi Killer")
            continue
        else
            KillerNotified = false
        end

        if zone ~= "Map" then
            ResetEsc()
            UI.status.Text = "Status: ZONE " .. zone .. " — tunggu match"
            UI.status.TextColor3 = Color3.fromRGB(80, 200, 255)
            continue
        end

        if MapStableStart == 0 then MapStableStart = now; MapConfirmedAt = nil end

        if Config.AutoEscape and not EscDone then
            TryEscape()

            if EscDone then
                if not EscNotified then
                    EscNotified = true
                    notify("VD AUTO ESCAPE", "✅ ESCAPE BERHASIL! Hop...", 3)
                end
                UI.status.Text = "Status: ESCAPED"
                UI.status.TextColor3 = Color3.fromRGB(80, 255, 120)
            end
            continue
        end

        UI.status.Text = "Status: DI MAP (escape idle)"
        UI.status.TextColor3 = Color3.fromRGB(255, 220, 100)
    end
