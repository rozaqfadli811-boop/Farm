local function findGuiObj(path)
    local parts = {}
    for p in string.gmatch(path, "[^%.]+") do
        table.insert(parts, p)
    end
    local cur = PlayerGui
    for _, p in ipairs(parts) do
        if not cur then return nil end
        cur = cur:FindFirstChild(p)
    end
    return cur
end

local function getText(path)
    local obj = findGuiObj(path)
    if obj and (obj:IsA("TextLabel") or obj:IsA("TextButton")) then
        return obj.Text
    end
    return nil
end

local function cleanNumber(str)
    if not str then return "?" end
    local cleaned = tostring(str):gsub("[^%d%.%,]", "")
    cleaned = cleaned:gsub(",", "")
    if cleaned == "" then return tostring(str) end
    return cleaned
end

local function FindTextByKeywords(keywords)
    for _, obj in ipairs(PlayerGui:GetDescendants()) do
        if obj:IsA("TextLabel") or obj:IsA("TextButton") then
            if obj.Visible and obj.Text and obj.Text ~= "" then
                for _, kw in ipairs(keywords) do
                    if obj.Name:lower():find(kw) or obj.Text:lower():find(kw) then
                        return obj.Text
                    end
                end
            end
        end
    end
    return nil
end

local function IsCountdownActive()
    for _, obj in ipairs(PlayerGui:GetDescendants()) do
        if (obj:IsA("TextLabel") or obj:IsA("TextButton")) and obj.Visible and obj.Text ~= "" then
            local absY = obj.AbsolutePosition.Y
            if absY < 200 then
                local text = obj.Text:match("^%s*(.-)%s*$")
                local nameLow = obj.Name:lower()

                local mm, ss = text:match("^(%d+):(%d+)$")
                if mm and ss then
                    local total = tonumber(mm) * 60 + tonumber(ss)
                    if total and total >= 1 and total <= 300 then
                        return true
                    end
                end

                local onlySec = text:match("^(%d+)$")
                if onlySec then
                    local total = tonumber(onlySec)
                    if total and total >= 10 and total <= 90 then
                        if nameLow:find("timer") or nameLow:find("countdown")
                        or nameLow:find("round") or nameLow:find("clock")
                        or nameLow:find("time") or nameLow:find("match") then
                            return true
                        end
                    end
                end
            end
        end
    end
    return false
end

local _cachedXP = nil
local _lastXPFetch = 0

local function GetSurvivorXP()
    local now = os.clock()
    if _cachedXP and (now - _lastXPFetch) < 1 then
        return _cachedXP
    end

    local rs = ReplicatedStorage
    local remotes = rs:FindFirstChild("Remotes")
    if remotes then
        local shopSurv = remotes:FindFirstChild("ShopSurvivors")
        if shopSurv then
            local getXP = shopSurv:FindFirstChild("GetSurvivorsXP")
            if getXP and getXP:IsA("RemoteFunction") then
                local tests = {
                    {}, {LocalPlayer.Name}, {LocalPlayer.UserId}, {LocalPlayer},
                }
                for _, args in ipairs(tests) do
                    local ok, result = pcall(function()
                        return getXP:InvokeServer(table.unpack(args))
                    end)
                    if ok and result ~= nil and result ~= false then
                        if type(result) == "table" then
                            result = result.XP or result.Exp or result.Value
                                or result.xp or result.exp or result[1]
                        end
                        if tonumber(result) then
                            _cachedXP = result
                            _lastXPFetch = now
                            return result
                        end
                    end
                end
            end
        end
    end

    local xpAttr = LocalPlayer:GetAttribute("EXP")
    if xpAttr then _cachedXP = xpAttr; _lastXPFetch = now; return xpAttr end

    xpAttr = LocalPlayer:GetAttribute("ExpinRound")
    if xpAttr then _cachedXP = xpAttr; _lastXPFetch = now; return xpAttr end

    local uiXP = FindTextByKeywords({"exp", "xp", "experience"})
    if uiXP then
        _cachedXP = uiXP
        _lastXPFetch = now
        return uiXP
    end

    return _cachedXP
end

local function GetStats()
    local stats = {
        Username = LocalPlayer.Name,
        DisplayName = LocalPlayer.DisplayName,
        UserId = LocalPlayer.UserId,
        Level = "?",
        EXP = "?",
        Gears = "?",
        Screws = "?",
        Timestamp = os.date("%Y-%m-%d %H:%M:%S"),
        JobId = tostring(game.JobId):sub(1, 8),
        PlayerCount = #Players:GetPlayers(),
        Trigger = "auto",
    }

    local lvlTxt = getText("Spectator.Info.Your.Border.Level")
    if lvlTxt and lvlTxt ~= "" then stats.Level = cleanNumber(lvlTxt) end

    local grsTxt = getText("Spectator.Info.Your.Gears")
    if grsTxt and grsTxt ~= "" then stats.Gears = cleanNumber(grsTxt) end

    local scrTxt = getText("Spectator.Info.Your.Screws")
    if scrTxt and scrTxt ~= "" then stats.Screws = cleanNumber(scrTxt) end

    if stats.Level == "?" then
        local found = FindTextByKeywords({"level", "lvl", "tingkat"})
        if found then stats.Level = cleanNumber(found) end
    end
    if stats.Gears == "?" then
        local found = FindTextByKeywords({"gear", "peralatan"})
        if found then stats.Gears = cleanNumber(found) end
    end
    if stats.Screws == "?" then
        local found = FindTextByKeywords({"screw", "sekrup", "baut"})
        if found then stats.Screws = cleanNumber(found) end
    end

    local xp = GetSurvivorXP()
    if xp then
        stats.EXP = cleanNumber(tostring(xp))
    end

    return stats
end

