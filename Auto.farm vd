local function SendToWebhook(stats, triggerReason)
    stats = stats or GetStats()
    triggerReason = triggerReason or stats.Trigger or "auto"

    if not WEBHOOK_URL or WEBHOOK_URL == "" or WEBHOOK_URL:find("ISI_URL_LO") then
        wlog("✗ Webhook URL belum diisi!")
        return false, "URL kosong"
    end

    local embedColor = 3066993
    if triggerReason == "manual" then
        embedColor = 3447003
    elseif triggerReason == "periodic" then
        embedColor = 10181046
    end

    local title = "📊 Statistik Auto Farm"
    if triggerReason == "escape" then
        title = "🏆 ESCAPE SUKSES — Statistik"
    end

    local payload = {
        username = "VD Auto Farm Logger",
        embeds = {
            {
                title = title,
                description = "**VD** — " .. stats.Timestamp .. "\nTrigger: `" .. triggerReason .. "`",
                color = embedColor,
                fields = {
                    { name = "👤 Username", value = "`" .. tostring(stats.DisplayName) .. "` (@"
                        .. tostring(stats.Username) .. ")\nID: `" .. tostring(stats.UserId) .. "`",
                        inline = false },
                    { name = "📈 Level",  value = "**" .. tostring(stats.Level) .. "**",  inline = true },
                    { name = "✨ EXP",    value = "**" .. tostring(stats.EXP) .. "**",    inline = true },
                    { name = "⚙️ Gears",  value = "**" .. tostring(stats.Gears) .. "**",  inline = true },
                    { name = "🔩 Screws", value = "**" .. tostring(stats.Screws) .. "**", inline = true },
                    { name = "🌐 Server", value = "JobId: `" .. stats.JobId
                        .. "`\nPlayers: `" .. stats.PlayerCount .. "`", inline = false },
                },
                footer = { text = "VD Auto Farm Webhook" },
                timestamp = DateTime.now():ToIsoDate(),
            }
        }
    }

    local body = HttpService:JSONEncode(payload)

    local ok = pcall(function()
        HttpService:PostAsync(WEBHOOK_URL, body, Enum.HttpContentType.ApplicationJson)
    end)
    if ok then return true end

    if type(request) == "function" then
        local ok2 = pcall(function()
            request({
                Url = WEBHOOK_URL,
                Method = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body = body,
            })
        end)
        if ok2 then return true end
    end

    if type(http_request) == "function" then
        local ok3 = pcall(function()
            http_request({
                Url = WEBHOOK_URL,
                Method = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body = body,
            })
        end)
        if ok3 then return true end
    end

    return false, "all methods failed"
end

