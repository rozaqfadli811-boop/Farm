local function GetFolderCenter(folder)
    if not folder then return nil end
    local sum, count = Vector3.new(0,0,0), 0
    for _, o in ipairs(folder:GetDescendants()) do
        if o:IsA("BasePart") then
            sum = sum + o.Position; count = count + 1
            if count >= 50 then break end
        end
    end
    if count == 0 then return nil end
    return sum / count
end

local function GetZoneRaw()
    local myPos = GetCharPos()
    if not myPos then return nil end
    local ws = workspace
    local spawnPart = ws:FindFirstChild("SpawnLocation")
    local mapFolder = ws:FindFirstChild("Map")
    local lobbyFolder = ws:FindFirstChild("Lobby")
    local spawnDist, mapDist, lobbyDist
    if spawnPart and spawnPart:IsA("BasePart") then
        spawnDist = (myPos - spawnPart.Position).Magnitude
    end
    if mapFolder then
        local center = GetFolderCenter(mapFolder)
        if center then mapDist = (myPos - center).Magnitude end
    end
    if lobbyFolder then
        local center = GetFolderCenter(lobbyFolder)
        if center then lobbyDist = (myPos - center).Magnitude end
    end
    if spawnDist and spawnDist < 100 then return "Lobby" end
    if lobbyDist and lobbyDist < 100 then return "Lobby" end
    if mapDist and mapDist < Config.MapDistThreshold then return "Map" end
    return nil
end

