local DOOR_NAMES = {
    "ExitDoor", "EscapeDoor", "DoorExit",
    "ExitGate", "EscapeGate",
    "MainGate", "MainDoor",
    "ExitPortal", "Exit",
    "Gate", "Door",
}

local NOT_DOOR = {
    "lever", "trigger", "button", "sign", "label",
    "prompt", "hint", "decal", "surfacegui", "billboard",
}

local function IsNotDoor(name)
    local lower = name:lower()
    for _, nd in ipairs(NOT_DOOR) do
        if lower:find(nd, 1, true) then return true end
    end
    return false
end

local function FindExitDoor()
    local ws = workspace
    local mapFolder = ws:FindFirstChild("Map")
    local candidates = {}

    local function scanFolder(root, priority)
        if not root then return end
        for _, d in ipairs(root:GetDescendants()) do
            if IsNotDoor(d.Name) then continue end
            for _, name in ipairs(DOOR_NAMES) do
                if d.Name:lower():find(name:lower(), 1, true) then
                    local hasPart = false
                    if d:IsA("BasePart") then hasPart = true
                    elseif d:IsA("Model") then
                        for _, p in ipairs(d:GetDescendants()) do
                            if p:IsA("BasePart") then hasPart = true; break end
                        end
                    end
                    if hasPart then
                        table.insert(candidates, { obj = d, priority = priority, nameLen = #d.Name })
                    end
                    break
                end
            end
        end
    end

    if mapFolder then
        local gateFolder = mapFolder:FindFirstChild("Gate")
        if gateFolder then scanFolder(gateFolder, 1) end
        scanFolder(mapFolder, 2)
    end
    scanFolder(ws, 3)

    if #candidates == 0 then return nil end

    table.sort(candidates, function(a, b)
        if a.priority ~= b.priority then return a.priority < b.priority end
        return a.nameLen < b.nameLen
    end)

    return candidates[1].obj
end

local function GetExitPosition(door)
    if not door then return nil, nil end
    if door:IsA("BasePart") then return door.Position, door end
    if door:IsA("Model") then
        if door.PrimaryPart then return door.PrimaryPart.Position, door.PrimaryPart end
        local bestPart, bestSize = nil, 0
        for _, p in ipairs(door:GetDescendants()) do
            if p:IsA("BasePart") then
                local sz = p.Size.X * p.Size.Y * p.Size.Z
                if sz > bestSize then bestSize = sz; bestPart = p end
            end
        end
        if bestPart then return bestPart.Position, bestPart end
    end
    return nil, nil
end

