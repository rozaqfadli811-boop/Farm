local function GetServers()
    local url = string.format(
        "https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=%d",
        Config.PlaceId, Config.MaxServersToScan)
    local ok, data = pcall(function()
        return HttpService:JSONDecode(game:HttpGet(url))
    end)
    if ok and data and data.data then return data.data end
    return {}
end

local function PickServer(servers, excludeIds)
    excludeIds = excludeIds or {}
    if not servers or #servers == 0 then
        return nil, "no servers", 0
    end

    local candidates = {}
    for _, s in ipairs(servers) do
        if s.id ~= game.JobId
           and not excludeIds[s.id]
           and s.playing < s.maxPlayers
        then
            table.insert(candidates, s)
        end
    end

    if #candidates == 0 then
        return nil, "semua udah dicoba", 0
    end

    table.sort(candidates, function(a, b)
        if a.playing ~= b.playing then
            return a.playing < b.playing
        end
        return (a.maxPlayers - a.playing) > (b.maxPlayers - b.playing)
    end)

    local pick = candidates[1]
    local mode
    if pick.playing == 0 then mode = "KOSONG (0p)"
    else mode = "sepi (" .. pick.playing .. "p)" end

    return pick, mode, #candidates
end

