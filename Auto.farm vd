--==================================================
-- ★★★ PICK SERVER — PALING SEPI (TANPA MAX) ★★★
--==================================================
-- Urutan: playing paling kecil → paling besar
-- Server KOSONG (0p) = prioritas utama
-- Ga ada batasan max player
--==================================================

local function PickServer(servers, excludeIds)
    excludeIds = excludeIds or {}

    if not servers or #servers == 0 then
        return nil, "no servers", 0
    end

    -- Kumpulkan semua kandidat valid (belum dicoba + masih ada slot)
    local candidates = {}
    for _, s in ipairs(servers) do
        if s.id ~= game.JobId
           and not excludeIds[s.id]
           and s.playing < s.maxPlayers
        then
            table.insert(candidates, s)
        end
    end

    if #candidates == 0 then
        return nil, "semua server udah dicoba", 0
    end

    -- ★ SORT: PALING SEPI DULU (playing terkecil)
    table.sort(candidates, function(a, b)
        if a.playing ~= b.playing then
            return a.playing < b.playing   -- playing terkecil = paling sepi
        end
        -- Kalau sama, prioritas yang slot kosong lebih banyak
        return (a.maxPlayers - a.playing) > (b.maxPlayers - b.playing)
    end)

    local pick = candidates[1]

    -- Info mode
    local mode
    if pick.playing == 0 then
        mode = "KOSONG (0p)"
    else
        mode = "sepi (" .. pick.playing .. "p)"
    end

    return pick, mode, #candidates
end

--==================================================
-- HOP WITH RETRY
--==================================================

local HopToServer, ScheduleHopRetry

ScheduleHopRetry = function(reason)
    if not HopInProgress then return end
    HopInProgress = false
    Hopping = false

    if HopRetryCount >= Config.HopRetryMax then
        print("[VD v43] ❌ Retry habis — reset & ulang dari awal")
        HopRetryCount = 0
        TriedServers = {}
        task.delay(3, function()
            HopToServer(reason, true)
        end)
        return
    end

    HopRetryCount = HopRetryCount + 1
    notify("VD AUTO HOP", "⚠️ Server penuh, retry #" .. HopRetryCount, 2)
    print("[VD v43] ⚠️ Retry hop #" .. HopRetryCount)

    task.delay(Config.HopRetryDelay, function()
        HopToServer(reason, true)
    end)
end

HopToServer = function(reason, isRetry)
    if Hopping then return end
    if not Config.AutoHop then return end

    if not isRetry then
        HopRetryCount = 0
        TriedServers = {}
    end

    Hopping = true
    HopInProgress = true
    HopReason = reason or "cari server sepi"

    UI.status.Text = "Status: Hoping..." .. (isRetry and (" [R" .. HopRetryCount .. "]") or "")
    UI.status.TextColor3 = Color3.fromRGB(255, 200, 80)

    notify("VD AUTO HOP", "🚀 Hop → " .. HopReason
        .. (isRetry and (" [R" .. HopRetryCount .. "]") or ""), 2)
    print("[VD v43] HOP: " .. HopReason
        .. (isRetry and (" (retry #" .. HopRetryCount .. ")") or ""))

    StopNoclip()

    local servers = GetServers()

    -- Cari target
    local target, mode, count = PickServer(servers, TriedServers)

    -- Kalau semua udah dicoba → reset & cari ulang
    if not target then
        print("[VD v43] ⚠️ " .. tostring(mode) .. " — reset daftar")
        TriedServers = {}
        task.wait(2)
        local retryTarget, retryMode = PickServer(servers, TriedServers)
        if retryTarget then
            target = retryTarget
            mode = retryMode
        end
    end

    LastHop = os.clock()
    ResetEsc()
    MapStableStart = 0; MapConfirmedAt = nil
    StableZone = nil; LastZoneCheck = nil; ZoneStableStart = 0
    LastRawZone = nil
    WasInMap = false
    JustEscaped = false
    LobbyArrivedAt = nil

    if target then
        TriedServers[target.id] = true

        print(string.format("[VD v43] 🎯 Target: %d/%d [%s] | %d kandidat",
            target.playing, target.maxPlayers, mode, count or 0))
        UI.info4.Text = "Hop: " .. target.playing .. "/" .. target.maxPlayers

        Hopping = false

        local ok, err = pcall(function()
            TeleportService:TeleportToPlaceInstance(
                Config.PlaceId, target.id, LocalPlayer)
        end)

        if not ok then
            print("[VD v43] ⚠️ Teleport error: " .. tostring(err))
            task.spawn(function() ScheduleHopRetry(HopReason) end)
            return
        end

        task.delay(Config.HopTimeoutCheck, function()
            if HopInProgress then
                print("[VD v43] ⏱️ Timeout, retry")
                ScheduleHopRetry(HopReason)
            end
        end)
    else
        print("[VD v43] ❌ Server list kosong → tunggu 5s retry")
        Hopping = false
        HopInProgress = false
        task.delay(5, function()
            HopToServer(reason, true)
        end)
    end
end

