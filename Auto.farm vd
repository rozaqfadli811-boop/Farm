local function TryEscape()
    if not Config.AutoEscape then return false end
    if EscDone then return true end

    local now = os.clock()

    if not EscStart then
        EscStart = now
        EscBeganAt = now
        StartPos = GetCharPos()
        print("[VD v43] START escape...")
    end

    if (now - EscStart) > Config.EscapeTimeout then
        UI.status.Text = "Status: ESCAPE TIMEOUT"
        UI.status.TextColor3 = Color3.fromRGB(255, 100, 100)
        return false
    end

    if IsEscaped() then
        print("[VD v43] ✔ ESCAPED DETECTED!")
        EscDone = true
        JustEscaped = true
        EscDoneAt = now
        StopNoclip()
        return true
    end

    if (now - EscRetry) < Config.RetryDelay then return false end
    EscRetry = now
    EscAttempt = EscAttempt + 1

    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    if Config.AutoNoclip then
        StartNoclip(Config.NoclipWalkTime + 8)
    end

    if Config.FireLeverFirst and EscAttempt <= 2 then
        FireLeverEvent()
        task.wait(Config.LeverWaitTime)
    end

    local finishLine = FindFinishLine()
    if finishLine then
        UI.info5.Text = "TP: " .. finishLine.Name

        for i = 1, 5 do
            hrp.CFrame = CFrame.new(
                finishLine.Position.X,
                finishLine.Position.Y + 3,
                finishLine.Position.Z
            )
            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            pcall(function() hrp.Velocity = Vector3.new(0, 0, 0) end)
            task.wait(0.2)

            hrp.CFrame = CFrame.new(
                finishLine.Position.X + math.random(-3, 3),
                finishLine.Position.Y + 3,
                finishLine.Position.Z + math.random(-3, 3)
            )
            task.wait(0.15)

            if IsEscaped() then
                EscDone = true
                JustEscaped = true
                EscDoneAt = os.clock()
                StopNoclip()
                print("[VD v43] ✔✔✔ ESCAPED via FinishLine!")
                return true
            end
        end
    else
        UI.info5.Text = "FinishLine NOT FOUND"
        FireLeverEvent()
    end

    UI.status.Text = string.format("Status: ESCAPE ATT %d", EscAttempt)
    UI.status.TextColor3 = Color3.fromRGB(100, 255, 150)
    return false
end

local function ResetEsc()
    EscStart = nil
    EscDone = false
    EscDoneAt = nil
    EscRetry = 0
    EscAttempt = 0
    EscNotified = false
    EscBeganAt = nil
    StartPos = nil
    StopNoclip()
end

