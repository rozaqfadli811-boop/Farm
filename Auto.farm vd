local function FindFinishLine()
    local mapFolder = workspace:FindFirstChild("Map")
    if not mapFolder then return nil end

    for _, obj in ipairs(mapFolder:GetDescendants()) do
        if obj:IsA("BasePart") then
            local lower = obj.Name:lower()
            if lower == "fininshline"
               or lower == "finishline"
               or lower == "finish_line"
               or lower == "finish line"
               or lower == "finish"
            then
                return obj
            end
        end
    end

    local gateFolder = mapFolder:FindFirstChild("Gate")
    if gateFolder then
        for _, child in ipairs(gateFolder:GetChildren()) do
            if child:IsA("BasePart") then
                local lower = child.Name:lower()
                if lower:find("end", 1, true)
                   or lower:find("finish", 1, true)
                then
                    return child
                end
            end
        end
    end

    return nil
end

